{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: dev server",
      "type": "process",
      "command": "${env:USERPROFILE}/.bun/bin/bun.exe",
      "args": ["--hot", "server.ts"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "bun",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "^.",
          "endsPattern": "bunact running at"
        }
      }
    },
    {
      "label": "bun: stop dev server",
      "type": "shell",
      "command": "echo ${input:terminateTasks}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateTasks",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
