{
  "version": "0.2.0",
  "configurations": [
    {
      // Debug the framework + app in the browser (breakpoints in src/*.tsx).
      // Starts the Bun dev server first, opens Edge, stops the server when you stop debugging.
      "name": "Debug app in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "bun: dev server",
      "postDebugTask": "bun: stop dev server"
    },
    {
      // Same, but attaches to a dev server you already started with `bun run dev`.
      "name": "Debug app in Edge (server already running)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      // Debug server.ts itself. Requires the "Bun for Visual Studio Code" extension (oven.bun-vscode).
      "name": "Debug server.ts (Bun)",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/server.ts",
      "cwd": "${workspaceFolder}",
      "runtime": "${env:USERPROFILE}/.bun/bin/bun.exe",
      "stopOnEntry": false,
      "watchMode": false
    }
  ]
}
